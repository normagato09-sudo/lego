# Credenciales de Supabase
# Copia este archivo como .env.local y rellena los valores reales.
# Puedes encontrarlos en: Panel de Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" (Project Settings > API > Project API keys).
# SOLO se usa en el servidor (Server Components / Server Actions) para
# saltar RLS mientras la app no tiene autenticación. NUNCA debe llevar el
# prefijo NEXT_PUBLIC_ ni exponerse en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
